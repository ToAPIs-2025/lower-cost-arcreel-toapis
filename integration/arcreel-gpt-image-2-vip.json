{
  "kind": "declarative",
  "schema_version": "1.2.0",
  "media_type": "image",
  "meta": {
    "name": "ToAPIs gpt-image-2-vip",
    "author": "ToAPIs",
    "version": "1.0.0"
  },
  "auth": {
    "headers": {
      "Authorization": "Bearer {{ api_key }}"
    }
  },
  "submit": {
    "method": "POST",
    "url": "{{ base_url }}/v1/images/generations",
    "body": {
      "model": "gpt-image-2-vip",
      "prompt": "{{ prompt }}",
      "size": "1536x864",
      "n": 1,
      "resolution": "1K",
      "quality": "low"
    },
    "extract": {
      "task_id": {
        "paths": [
          "$.id"
        ],
        "accept": "scalar"
      },
      "error": [
        "$.error.message"
      ]
    }
  },
  "poll": {
    "method": "GET",
    "url": "{{ base_url }}/v1/images/generations/{{ task_id }}",
    "extract": {
      "status": [
        "$.status"
      ],
      "image_url": [
        "$.result.data[0].url"
      ],
      "error": [
        "$.error.message"
      ]
    }
  },
  "status_map": {
    "completed": "succeeded",
    "in_progress": "running",
    "expired": "failed",
    "cancelled": "failed"
  },
  "capabilities": {
    "text_to_image": true,
    "image_to_image": false
  }
}